# Ключ для X-API-Key. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me

REDIS_URL=redis://redis:6379/0
QUEUE_NAME=cashguard
STORAGE_DIR=/srv/storage

# Хранение задач (сек). Видео удаляется сразу после обработки, результат — через JOB_TTL_SEC.
JOB_TTL_SEC=3600
MAX_UPLOAD_MB=200
# Жёсткий таймаут задачи в RQ (сек). Внутренний бюджет пайплайна — 270 с (configs/pipeline.yaml).
JOB_TIMEOUT_SEC=300

# true — в ответе только поля из ТЗ (без rule/confidence/source). Если не задано — из configs/pipeline.yaml.
STRICT_SCHEMA=false

# Задержка mock-пайплайна (этап 1)
MOCK_DELAY_SEC=5

# Домен для nginx/TLS
DOMAIN=example.com
